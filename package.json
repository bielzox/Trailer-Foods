{
  "name": "trailer-foods",
  "productName": "Trailer Foods",
  "version": "1.0.0",
  "description": "Cardápio do Trailer Foods (PC)",
  "author": "Trailer Foods",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start-admin": "electron admin/admin-main.js",
    "dist": "electron-builder --win",
    "dist-admin": "electron-builder --win --config admin/electron-builder.admin.json"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lanchonete.cardapio",
    "productName": "Trailer Foods",
    "directories": { "output": "instalador" },
    "files": ["main.js", "preload.js", "index.html", "cardapio.js", "supabase.js", "config.js", "icone.png", "icone.ico", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icone.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trailer Foods",
      "installerIcon": "icone.ico",
      "uninstallerIcon": "icone.ico",
      "installerHeaderIcon": "icone.ico"
    }
  }
}
